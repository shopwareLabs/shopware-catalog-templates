              "slots": [
                {
                  "type": "text",
                  "slot": "content",
                  "textContent": "<div style=\"padding: 60px 20px; text-align: center;\">\n<h2 style=\"color: white; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);\">Turn Up Your Inspiration</h2>\n<p style=\"color: white; text-shadow: 1px 1px 2px rgba(0,0,0,0.5); max-width: 600px; margin: 0 auto;\">Discover instruments and music-making essentials for practice, recording, and live performance—then find the sound that's yours.</p>\n</div>"
