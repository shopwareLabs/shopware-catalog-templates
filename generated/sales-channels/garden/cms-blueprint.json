                {
                  "type": "text",
                  "slot": "content",
                  "textContent": "<h1 style=\"text-align: center; font-size: 2.5em; margin-bottom: 16px;\">Ideas for Every Garden</h1>\n<p style=\"text-align: center; font-size: 1.2em; color: #666; max-width: 600px; margin: 0 auto;\">Find inspiration for growing, furnishing and enjoying your outdoor space, with thoughtful picks for balconies, backyards and every green space in between.</p>"
