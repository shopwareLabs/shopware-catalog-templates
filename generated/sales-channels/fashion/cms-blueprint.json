                },
                {
                  "type": "text",
                  "slot": "right-text",
                  "textContent": "<h3 style=\"text-align: center; margin-bottom: 8px;\">Occasion Wear</h3>\n<p style=\"text-align: center; color: #666; font-size: 0.9em;\">Standout styles for celebrations and special moments</p>"
