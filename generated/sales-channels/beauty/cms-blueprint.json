      "sections": [
        {
          "blocks": [
            {
              "type": "text-hero",
              "position": 0,
              "slots": [
                {
                  "type": "text",
                  "slot": "content",
                  "textContent": "<h1 style=\"text-align: center;\">Text & Images</h1><p style=\"text-align: center;\">Discover how to showcase your favorite beauty products with inspiring layouts and stunning visuals.</p>"
                }
              ]
            },
            {
              "type": "image-text",
              "position": 1,
              "slots": [
                {
                  "type": "text",
                  "slot": "right",
                  "textContent": "<h2>Image-Text Block</h2><p>This setup highlights your chosen product with an image on the left and details on the right. Showcase skincare must-haves, bestseller spotlights, or expert tips alongside beautiful visuals.</p><p>The image scales fluidly to match the content, ensuring your beauty essentials always look their best.</p>"
                }
              ]
            },
            {
              "type": "image-text",
              "position": 2,
              "slots": [
                {
                  "type": "text",
                  "slot": "left",
                  "textContent": "<h2>Reversed Layout</h2><p>Place text on the left and an image on the right for a fresh, modern look. Alternate this style to balance product information and lifestyle photography for your beauty story.</p><p>Mixing layouts keeps the browsing experience fresh while highlighting new arrivals and seasonal picks.</p>"
                }
              ]
            },
            {
              "type": "center-text",
              "position": 3,
              "slots": [
                {
                  "type": "text",
                  "slot": "center",
                  "textContent": "<h2 style=\"text-align: center;\">Center Text</h2><p style=\"text-align: center;\">With images on either side, put the focus on your signature collections or brand philosophy in the center. This style is ideal for sharing what makes your beauty store unique.</p>"
                }
              ]
            },
            {
              "type": "image-text-bubble",
              "position": 4,
              "slots": [
                {
                  "type": "text",
                  "slot": "left-text",
                  "textContent": "<h3 style=\"text-align: center;\">Gentle Skincare</h3><p style=\"text-align: center;\">Explore nourishing cleansers and soothing moisturizers, formulated for sensitive and all skin types.</p>"
                },
                {
                  "type": "text",
                  "slot": "center-text",
                  "textContent": "<h3 style=\"text-align: center;\">Flawless Makeup</h3><p style=\"text-align: center;\">Find trending cosmetics for every complexion, from luminous foundations to bold lip colors.</p>"
                },
                {
                  "type": "text",
                  "slot": "right-text",
                  "textContent": "<h3 style=\"text-align: center;\">Glow Essentials</h3><p style=\"text-align: center;\">Complete your beauty ritual with serums, masks, and tools for a radiant, healthy glow.</p>"
                }
              ]
            },
            {
              "type": "text-on-image",
              "position": 5,
              "slots": [
                {
                  "type": "text",
                  "slot": "content",
                  "textContent": "<div style=\"padding: 60px 20px; text-align: center;\"><h2 style=\"color: white; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);\">Unveil Your Radiance</h2><p style=\"color: white; text-shadow: 1px 1px 2px rgba(0,0,0,0.5); max-width: 600px; margin: 0 auto;\">Let your natural beauty shine. Explore our curated collections designed to inspire confidence and self-care in every routine.</p></div>"
                }
