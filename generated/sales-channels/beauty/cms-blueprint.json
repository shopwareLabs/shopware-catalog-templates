    {
      "name": "CMS Element Showcase",
      "processor": "cms-welcome",
      "sections": [
        {
          "blocks": [
            {
              "type": "text-hero",
              "position": 0,
              "slots": [
                {
                  "type": "text",
                  "slot": "content",
                  "textContent": "<h1 style=\"text-align: center; font-size: 2.5em; margin-bottom: 16px;\">Beauty Essentials CMS Inspiration</h1><p style=\"text-align: center; font-size: 1.2em; color: #666; max-width: 600px; margin: 0 auto;\">Experience the best of our beauty store’s creative layouts. Each section reveals how we display our premium skincare and makeup collections, making it easy for you to discover glowing results.</p>"
                }
              ]
            },
            {
              "type": "image-text-bubble",
              "position": 1,
              "slots": [
                {
                  "type": "text",
                  "slot": "left-text",
                  "textContent": "<h3 style=\"text-align: center; margin-bottom: 8px;\">Text Features</h3><p style=\"text-align: center; color: #666; font-size: 0.9em;\">Highlights include glowing banners, beauty tips, routines, and expert guides presented in elegant styles.</p>"
                },
                {
                  "type": "text",
                  "slot": "center-text",
                  "textContent": "<h3 style=\"text-align: center; margin-bottom: 8px;\">Image Features</h3><p style=\"text-align: center; color: #666; font-size: 0.9em;\">Browse collections with curated lifestyle galleries, product spotlights, and trending looks.</p>"
                },
                {
                  "type": "text",
                  "slot": "right-text",
                  "textContent": "<h3 style=\"text-align: center; margin-bottom: 8px;\">Video Features</h3><p style=\"text-align: center; color: #666; font-size: 0.9em;\">Watch application tutorials, product reviews, and skincare routines right here.</p>"
                }
              ]
            },
            {
              "type": "center-text",
              "position": 2,
              "slots": [
                {
                  "type": "text",
                  "slot": "center",
                  "textContent": "<h2 style=\"text-align: center; margin-bottom: 12px;\">Text & Images</h2><p style=\"text-align: center; color: #666;\">Showcase radiant transformations by blending expert tips and real customer photos. Dynamic layouts pair product details with before-and-after images and insightful advice.</p>"
                }
              ]
            },
            {
              "type": "text-two-column",
              "position": 3,
              "slots": [
                {
                  "type": "text",
                  "slot": "left",
                  "textContent": "<h3>Commerce Elements</h3><p>Display top beauty must-haves and skincare routines with our interactive shop features:</p><ul style=\"color: #666;\"><li>Featured product carousels</li><li>Shoppable image galleries</li><li>Effortless category browsing</li></ul>"
                },
                {
                  "type": "text",
                  "slot": "right",
                  "textContent": "<h3>Form Elements</h3><p>Connect with your beauty community through simple forms:</p><ul style=\"color: #666;\"><li>Personalized skincare consultation forms</li><li>Email list signup for new looks and promos</li><li>Order and appointment confirmations</li></ul>"
                }
              ]
            },
