              "position": 3,
              "slots": [
                {
                  "type": "text",
                  "slot": "center",
                  "textContent": "<h2 style=\"text-align: center;\">Find Your Signature</h2>\n<p style=\"text-align: center;\">From expressive makeup to captivating fragrance, discover thoughtfully selected favorites that celebrate every skin tone and personal style.</p>"
