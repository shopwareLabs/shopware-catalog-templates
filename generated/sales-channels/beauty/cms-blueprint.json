                  "type": "text",
                  "slot": "center-text",
                  "textContent": "<h3 style=\"text-align: center;\">Skincare for Your Ritual</h3>\n<p style=\"text-align: center;\">Discover luxury skincare essentials to make your daily routine feel special.</p>"
