            {
              "type": "text-two-column",
              "position": 3,
              "slots": [
                {
                  "type": "text",
                  "slot": "left",
                  "textContent": "<h3>Shop by Category</h3>\n<p>Explore electronics for work, play and home:</p>\n<ul style=\"color: #666;\">\n    <li>Smartphones and accessories</li>\n    <li>Laptops, tablets and computers</li>\n    <li>Headphones, TVs and gaming gear</li>\n</ul>"
                },
                {
                  "type": "text",
                  "slot": "right",
                  "textContent": "<h3>Find the Right Fit</h3>\n<p>Choose technology to suit your needs and budget:</p>\n<ul style=\"color: #666;\">\n    <li>Options for everyday use and demanding tasks</li>\n    <li>Smart home devices and practical accessories</li>\n    <li>Choices across a range of features and prices</li>\n</ul>"
