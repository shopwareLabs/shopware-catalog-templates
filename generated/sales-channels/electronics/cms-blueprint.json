                  "slot": "content",
                  "textContent": "<h1 style=\"text-align: center; font-size: 2.5em; margin-bottom: 16px;\">Discover Electronics</h1>\n<p style=\"text-align: center; font-size: 1.2em; color: #666; max-width: 600px; margin: 0 auto;\">Explore smartphones, laptops, headphones and more for work, play and everyday life. Find the right tech for your needs and budget.</p>"
