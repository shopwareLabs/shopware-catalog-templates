                },
                {
                  "type": "text",
                  "slot": "right-text",
                  "textContent": "<h3 style=\"text-align: center; margin-bottom: 8px;\">Gaming & Smart Home</h3>\n<p style=\"text-align: center; color: #666; font-size: 0.9em;\">Level up your setup and make everyday routines easier</p>"
