                  "type": "text",
                  "slot": "left-text",
                  "textContent": "<h3 style=\"text-align: center;\">Stay Connected</h3>\n<p style=\"text-align: center;\">Explore smartphones and accessories for calls, messages and life on the move.</p>"
                },
                {
                  "type": "text",
                  "slot": "center-text",
                  "textContent": "<h3 style=\"text-align: center;\">Work and Create</h3>\n<p style=\"text-align: center;\">Find laptops and essentials to help you focus, create and get more done.</p>"
                },
                {
                  "type": "text",
                  "slot": "right-text",
                  "textContent": "<h3 style=\"text-align: center;\">Play and Unwind</h3>\n<p style=\"text-align: center;\">Choose headphones, TVs and gaming gear for entertainment that feels all your own.</p>"
